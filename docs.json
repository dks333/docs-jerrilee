{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Mintlify",
  "colors": {
    "primary": "#3E6553",
    "light": "#9EC8B1",
    "dark": "#315441"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Paper Shaders",
        "groups": [
          {
            "group": "Examples",
            "pages": [
              "paper-shaders/mesh-gradient",
              "paper-shaders/dot-orbit",
              "paper-shaders/warp",
              "paper-shaders/liquid-metal",
              "paper-shaders/dithering",
              "paper-shaders/grain-gradient"
            ]
          },
          {
            "group": "Setup",
            "pages": ["how-it-works"]
          }
        ]
      },
      {
        "tab": "Base UI",
        "groups": [
          {
            "group": "Examples",
            "pages": ["base-ui/dialog", "base-ui/combobox", "base-ui/menu", "base-ui/slider"]
          }
        ]
      },
      {
        "tab": "Tiptap",
        "groups": [
          {
            "group": "Examples",
            "pages": [
              "tiptap/editor",
              "tiptap/slash-commands",
              "tiptap/task-lists",
              "tiptap/tables"
            ]
          }
        ]
      },
      {
        "tab": "Recharts",
        "groups": [
          {
            "group": "Examples",
            "pages": [
              "recharts/area-chart",
              "recharts/composed-chart",
              "recharts/pie-chart",
              "recharts/synchronized-charts"
            ]
          }
        ]
      },
      {
        "tab": "React Flow",
        "groups": [
          {
            "group": "Examples",
            "pages": ["react-flow/workflow", "react-flow/custom-nodes", "react-flow/validation"]
          }
        ]
      },
      {
        "tab": "Motion",
        "groups": [
          {
            "group": "Examples",
            "pages": ["motion/springs", "motion/layout", "motion/reorder"]
          }
        ]
      }
    ]
  },
  "packages": {},
  "navbar": {
    "links": [
      {
        "label": "Documentation",
        "href": "https://www.mintlify.com/docs"
      }
    ]
  },
  "background": {
    "color": {
      "light": "#FBFAF7",
      "dark": "#151917"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  }
}
